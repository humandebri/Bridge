{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kinic-bridge-mint-recovery",
  "main": "index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "routes": [{ "pattern": "recovery.bridge.kinic.xyz", "custom_domain": true }],
  "vars": { "RECOVERY_ENABLED": "false" },
  "secrets": { "required": ["ALCHEMY_API_KEY", "CURSOR_KEY", "BRIDGE_PROFILE_JSON"] },
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "84530001", "simple": { "limit": 60, "period": 60 } },
    { "name": "DEPOSIT_LIMIT", "namespace_id": "84530002", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
