{
  "name": "@kinic/bridge-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.0.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsgo -b --pretty false",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:artifacts": "node scripts/download-ledger-artifacts.mjs",
    "e2e:real": "pnpm run e2e:artifacts && playwright test --config playwright.real.config.ts",
    "build:sepolia": "node scripts/build-sepolia-assets.mjs",
    "codegen": "pnpm run codegen:abi && pnpm run codegen:candid",
    "codegen:abi": "node scripts/generate-abi.mjs",
    "codegen:abi:check": "node scripts/generate-abi.mjs --check",
    "codegen:candid": "node scripts/generate-candid.mjs",
    "codegen:candid:check": "node scripts/generate-candid.mjs --check",
    "deploy:check": "node scripts/check-deploy-profile.mjs",
    "deploy": "pnpm run deploy:check && node scripts/production-assets.mjs deploy $BRIDGE_RELEASE_BUNDLE/ui-assets.json $BRIDGE_UI_RUNTIME_PROFILE_FILE",
    "deploy:preactivation": "node scripts/production-assets.mjs deploy-preactivation $BRIDGE_UI_PREACTIVATION_RECEIPT $BRIDGE_UI_RUNTIME_PROFILE_FILE",
    "deploy:preactivation:check": "node scripts/production-assets.mjs verify-preactivation $BRIDGE_UI_PREACTIVATION_RECEIPT $BRIDGE_UI_RUNTIME_PROFILE_FILE",
    "deploy:test": "pnpm run build:sepolia && node scripts/check-sepolia-assets.mjs && wrangler deploy --name kinic-bridge-ui-test",
    "artifact:test": "scripts/run-staging-assets.sh generate \"$BRIDGE_STAGING_UI_RECEIPT\"",
    "artifact:test:verify": "scripts/run-staging-assets.sh verify \"$BRIDGE_STAGING_UI_RECEIPT\"",
    "deploy:test:artifact": "scripts/run-staging-assets.sh deploy \"$BRIDGE_STAGING_UI_RECEIPT\""
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@dfinity/oisy-wallet-signer": "6.0.0",
    "@dfinity/utils": "4.2.1",
    "@dfinity/zod-schemas": "3.2.0",
    "@fontsource/manrope": "5.2.8",
    "@icp-sdk/canisters": "3.6.0",
    "@icp-sdk/core": "5.4.0",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@walletconnect/ethereum-provider": "2.23.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "viem": "2.55.1",
    "wagmi": "3.7.1",
    "zod": "4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@dfinity/pic": "0.23.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/router-plugin": "1.168.19",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
