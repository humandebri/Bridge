type ActivationAttestation = record {
  finalized_block_number : nat64;
  timelock_runtime_code_hash : blob;
  base_service_fee : nat;
  bsns_runtime_sha256 : blob;
  bsns_name : text;
  bsns_address : blob;
  observed_at_ns : nat64;
  bsns_decimals : nat8;
  timelock_proposer : blob;
  bsns_symbol : text;
  deposits_paused : bool;
  bridge_runtime_sha256 : blob;
  timelock_executor : blob;
  bridge_signer : blob;
  chain_id : nat64;
  bridge_approved_timelock_runtime_code_hash : blob;
  finalized_block_hash : blob;
  bsns_bridge : blob;
  timelock_minimum_delay_seconds : nat64;
  timelock_canceller : blob;
  timelock_admin : blob;
  runtime_administrator : blob;
  withdrawals_paused : bool;
  bridge_timelock : blob;
};
type ActivationConfirmationView = record {
  transaction_hash : blob;
  governance_operation_id : nat64;
  phase : text;
  timelock_operation_id : blob;
  receipt_block_number : nat64;
};
type ActivationOperationView = record { salt : blob; operation_id : blob };
type ActivationStatus = record {
  pending_timelock_operation : opt ActivationOperationView;
  deposits_paused : bool;
  last_confirmed_activation : opt ActivationConfirmationView;
};
type AdminError = variant {
  Busy;
  InsufficientFeeReserve;
  Unauthorized;
  InvalidArgument : text;
  StorageFailure;
};
type AuditEvent = record {
  timestamp_ns : nat64;
  kind : AuditEventKind;
  caller : principal;
  sequence : nat64;
};
type AuditEventKind = variant {
  DepositRefundRetried : record {
    next_fee : nat;
    deposit_id : blob;
    next_attempt_no : opt nat64;
    previous_attempt_no : nat64;
    compensated : bool;
    previous_fee : nat;
  };
  MintRevertRecoveryStarted : record {
    result : text;
    finalized_block_number : nat64;
    kind : AuditedEvmOperationKind;
    target_id : blob;
    finalized_block_hash : blob;
    reverted_operation_id : nat64;
    replacement_operation_id : nat64;
  };
  PausePrincipalRotated;
  EvmTransactionReplaced : record {
    transaction_hash : blob;
    max_priority_fee_per_gas : nat;
    generation : nat8;
    operation_id : nat64;
    max_fee_per_gas : nat;
    previous_transaction_hash : blob;
  };
  EvmOperationReverted : record {
    transaction_hash : blob;
    finalized_head_block_number : nat64;
    kind : AuditedEvmOperationKind;
    operation_id : nat64;
  };
  DepositsPauseRepeated;
  EvmRpcObservation : record {
    finalized_block_number : nat64;
    transaction_hash : opt blob;
    call_method : text;
    evm_rpc_canister_id : principal;
    finalized_block_hash : blob;
    quorum_response_digest : blob;
    request_digest : blob;
  };
  FeeRecipientChanged : record {
    previous : FeeRecipientConfig;
    current : FeeRecipientConfig;
  };
  WithdrawalFeeGuardCleared;
  DepositsPaused;
  EvmRpcDecision : record {
    bridge_operation_continued : bool;
    configured_provider_count : nat8;
    transaction_hash : opt blob;
    kind : text;
    deposits_paused : bool;
    automatically_resigned : bool;
    required_threshold : nat8;
    operation : text;
    ledger_call_performed : bool;
    stop_reason : opt text;
  };
  FeeRecipientRotated : record {
    previous_sha256 : blob;
    current_sha256 : blob;
  };
  EvmTransactionRebroadcasted : record {
    transaction_hash : blob;
    attempt : nat8;
    operation_id : nat64;
  };
  DepositsResumed;
  FeePayoutRequested : record { amount : nat };
  MintRevertRecoveryCompleted : record {
    result : text;
    finalized_block_number : nat64;
    kind : AuditedEvmOperationKind;
    target_id : blob;
    finalized_block_hash : blob;
    reverted_operation_id : nat64;
    replacement_operation_id : nat64;
  };
  ReserveGateChanged : record { sufficient : bool };
  WithdrawalFeeGuardTripped : record {
    charged_service_fee : nat;
    ledger_fee : nat;
  };
  EvmFeeQuoteObserved : record {
    base_fee_per_gas : nat;
    max_priority_fee_per_gas : nat;
    observed_at_ns : nat64;
    gas_estimate : nat;
    initial_max_fee_per_gas : nat;
    safe_block_hash : blob;
    reserved_eth_wei : nat;
    reachable_max_fee_per_gas : nat;
    gas_limit : nat;
    safe_block_number : nat64;
  };
};
type AuditEventPage = record {
  pruned_digest : blob;
  oldest_available_sequence : nat64;
  events : vec AuditEvent;
  next_sequence : opt nat64;
  pruned_count : nat64;
  pruned_through_sequence : opt nat64;
};
type AuditedEvmOperationKind = variant { MintDeposit };
type AutomaticProgressState = variant {
  Scheduled : record { next_run_at_ns : nat64 };
  Running : record { lease_until_ns : nat64 };
};
type AutomaticProgressView = record { state : AutomaticProgressState };
type BaseGovernanceAction = variant {
  ExecuteControlPlaneRotation;
  PauseDepositMints;
  SetServiceFee : record { value : nat };
  PauseWithdrawals;
  ScheduleControlPlaneRotation;
  CancelPendingTimelock;
};
type BaseGovernanceConfirmation = record {
  transaction_hash : blob;
  operation_id : nat64;
  receipt_block_number : nat64;
  succeeded : bool;
};
type BaseGovernanceError = variant {
  InsufficientGovernanceBalance : record {
    observed_wei : nat;
    required_wei : nat;
  };
  Busy : record { operation_id : nat64 };
  TransactionNotFinalized : record { operation_id : nat64 };
  InsufficientCycles;
  Unauthorized;
  RateLimited;
  InvalidArgument;
  TransactionReverted : record { operation_id : nat64 };
  StorageFailure;
  ObservationUnavailable;
  ReplacementLimitReached : record { operation_id : nat64 };
  SigningUnavailable : record { class : SigningFailureClass };
};
type BaseGovernanceOperationKind = variant {
  ExecuteControlPlaneRotation : record {
    independent_canceller : blob;
    salt : blob;
    generation : nat32;
    operation_id : blob;
    bridge_signer : blob;
    runtime_administrator : blob;
    governance_operator : blob;
  };
  PauseDepositMints;
  CancelTimelock : record { operation_id : blob };
  SetServiceFee : record { value : nat };
  PauseWithdrawals;
  ScheduleActivation : ActivationOperationView;
  ScheduleControlPlaneRotation : record {
    independent_canceller : blob;
    salt : blob;
    generation : nat32;
    operation_id : blob;
    bridge_signer : blob;
    runtime_administrator : blob;
    governance_operator : blob;
  };
  ExecuteActivation : ActivationOperationView;
};
type BridgeInitArgs = record {
  settlement_rate_limit_global : nat16;
  settlement_rate_limit_per_principal : nat16;
  settlement_cycle_ceiling : nat;
  settlement_rate_limit_per_record : nat16;
  governance_evm_fee : EvmFeePolicy;
  notification_rate_limit_global : nat16;
  deposit_rate_limit_window_seconds : nat64;
  ecdsa_key_name : text;
  base_chain_id : nat64;
  bridge_contract : blob;
  fee_recipient : FeeRecipientConfig;
  notification_rate_limit_window_seconds : nat64;
  settlement_rate_limit_window_seconds : nat64;
  ecdsa_derivation_path : vec blob;
  notification_ingestion_rate_limit_global : nat16;
  evm_rpc_canister_id : principal;
  deposit_rate_limit_per_principal : nat16;
  deployment_instance_id : blob;
  governance_ecdsa_derivation_path : vec blob;
  custom_evm_rpc_urls : vec text;
  minimum_withdrawal_id : blob;
  deposit_rate_limit_global : nat16;
  pause_principal : principal;
  governance_principal : principal;
  index_canister_id : principal;
  confirmation_relayer_principal : principal;
  ledger_canister_id : principal;
  expected_timelock_minimum_delay_seconds : nat64;
  expected_bsns_runtime_sha256 : blob;
  settlement_retry_interval_seconds : nat64;
  governance_replacement : GovernanceReplacementPolicy;
  expected_minimum_service_fee : nat;
  expected_bsns_decimals : nat8;
  expected_bridge_runtime_sha256 : blob;
  timelock_contract : blob;
  cycles_floor : nat;
};
type BridgeStatus = record {
  unpaid_withdrawal_count : nat64;
  withdrawal_fee_guard_ledger_fee : opt nat;
  mint_authorization_ttl_seconds : nat64;
  mint_authorization_epoch : nat64;
  unpaid_withdrawal_amount_out : nat;
  reserve : ReserveStatus;
  withdrawal_stop_reasons : vec text;
  audit_retention_warning : bool;
  deposits_paused : bool;
  schema_version : nat16;
  observed_bridge_runtime_sha256 : blob;
  last_finalized_observation_ns : nat64;
  withdrawal_fee_guard_active : bool;
  last_finalized_base_block : nat64;
  observed_bridge_signer : blob;
  oldest_unpaid_withdrawal_observed_at_ns : opt nat64;
  counts : StatusCounts;
  withdrawal_fee_guard_charged_service_fee : opt nat;
  settlement_scheduler : SettlementSchedulerStatus;
  last_finalized_base_block_hash : blob;
  last_audit_sequence : opt nat64;
};
type ChecksumRefreshStatus = record {
  scanned_bytes : nat64;
  db_size : nat64;
  complete : bool;
  checksum : nat64;
};
type ConfirmBaseGovernanceTransactionArgs = record {
  transaction_hash : blob;
  operation_id : nat64;
};
type DepositArgs = record {
  base_recipient : blob;
  max_service_fee : nat;
  from_subaccount : opt blob;
  owner_sequence : nat64;
  gross_amount : nat;
};
type DepositError = variant {
  Busy;
  FundingRejected : FundingFailure;
  BaseObservationUnavailable;
  SequenceMismatch : record { expected : nat64 };
  ReserveUnavailable;
  DepositsPaused;
  Rejected : text;
  DepositIdentityConflict;
  RateLimited : record { retry_after_seconds : nat64 };
  InvalidRequest : text;
  DepositConflict;
  StorageFailure;
  FundingUnavailable : record { retry_after_seconds : nat64 };
  ReservationMaintenance : record { retry_after_seconds : nat64 };
};
type DepositIdPage = record {
  history_truncated : bool;
  oldest_available_cursor : opt nat64;
  next_cursor : opt nat64;
  deposit_ids : vec blob;
};
type DepositPhase = variant {
  Refunded;
  FundingReconciliationHold;
  EscrowedUnquoted;
  AuthorizationAvailable;
  RefundProcessing;
  Minted;
  Cancelled;
  AuthorizationPending;
  RefundAvailable;
};
type DepositQuoteView = record { net_amount : nat; service_fee : nat };
type DepositReceipt = record {
  deposit_id : blob;
  state : DepositPhase;
  owner_sequence : nat64;
};
type DepositRefundReasonView = variant {
  ServiceFeeRejected;
  MintWindowLimitExceeded;
  BasePaused;
  AuthorizationExpired;
  PerDepositLimitExceeded;
};
type DepositRefundStatusView = variant {
  Sending;
  ReconciliationRequired;
  Completed;
};
type DepositRefundView = record {
  status : DepositRefundStatusView;
  refund_ledger_block_index : opt nat;
  attempt_no : nat64;
  ledger_fee : nat;
  amount : nat;
  reason : DepositRefundReasonView;
};
type DepositView = record {
  base_recipient : blob;
  deposit_id : blob;
  quote : opt DepositQuoteView;
  max_service_fee : nat;
  funding_ledger_block_index : opt nat;
  from_subaccount : opt blob;
  last_settlement_stop_reason : opt SettlementStopReason;
  created_at_ns : nat64;
  state : DepositPhase;
  available_refund_amount : opt nat;
  owner_sequence : nat64;
  mint_authorization : opt MintAuthorizationView;
  automatic_progress : opt AutomaticProgressView;
  gross_amount : nat;
  refund : opt DepositRefundView;
};
type EmergencyPauseReceipt = record {
  local_pause_audit_sequence : nat64;
  base_action_count : nat8;
  caller : principal;
  local_pause_audit_sha256 : blob;
  base_action_plan_sha256 : blob;
  local_deposits_paused : bool;
  base_actions_queued : bool;
};
type EvmFeePolicy = record {
  l1_fee_per_transaction_ceiling_wei : nat;
  quote_validity_seconds : nat64;
  gas_limit_ceiling : nat;
  max_priority_fee_per_gas_ceiling : nat;
  l1_fee_multiplier_bps : nat32;
  gas_limit_multiplier_bps : nat32;
  base_fee_multiplier_bps : nat32;
  max_fee_per_gas_ceiling : nat;
};
type FeePayoutActionResult = variant {
  Stopped : record { state : FeePayoutState; reason : SettlementStopReason };
  Complete : record { state : FeePayoutState };
  ReconciliationProgress : record { state : FeePayoutState };
};
type FeePayoutReceipt = record {
  id : nat64;
  state : FeePayoutState;
  amount : nat;
};
type FeePayoutState = variant {
  Failed;
  Succeeded : record { block_index : nat };
  ReconciliationHold;
  Pending;
};
type FeeRecipientConfig = record { owner : principal; subaccount : blob };
type FundingFailure = variant {
  InsufficientAllowance : record { allowance : nat };
  BadBurn : record { minimum : nat };
  BadFee : record { expected_fee : nat };
  InsufficientFunds : record { balance : nat };
};
type GetWithdrawalsError = variant { TooManyIds };
type GovernanceReplacementPolicy = record {
  fee_bump_bps : nat16;
  max_replacements : nat8;
};
type Icrc10SupportedStandard = record { url : text; name : text };
type Icrc21ConsentInfo = record {
  metadata : Icrc21ConsentMessageMetadata;
  consent_message : Icrc21ConsentMessage;
};
type Icrc21ConsentMessage = variant { GenericDisplayMessage : text };
type Icrc21ConsentMessageMetadata = record {
  utc_offset_minutes : opt int16;
  language : text;
};
type Icrc21ConsentMessageRequest = record {
  arg : blob;
  method : text;
  user_preferences : Icrc21ConsentMessageSpec;
};
type Icrc21ConsentMessageResponse = variant {
  Ok : Icrc21ConsentInfo;
  Err : Icrc21Error;
};
type Icrc21ConsentMessageSpec = record {
  metadata : Icrc21ConsentMessageMetadata;
  device_spec : opt Icrc21DeviceSpec;
};
type Icrc21DeviceSpec = variant { GenericDisplay; FieldsDisplay };
type Icrc21Error = variant {
  GenericError : Icrc21GenericError;
  InsufficientPayment : Icrc21ErrorInfo;
  UnsupportedCanisterCall : Icrc21ErrorInfo;
  ConsentMessageUnavailable : Icrc21ErrorInfo;
};
type Icrc21ErrorInfo = record { description : text };
type Icrc21GenericError = record { description : text; error_code : nat };
type ListDepositIdsArgs = record {
  owner : principal;
  limit : nat16;
  before_cursor : opt nat64;
};
type ListDepositIdsError = variant { InvalidLimit };
type MintAuthorizationView = record {
  finalized_block_number : nat64;
  signature : opt blob;
  deposit_id : blob;
  domain_name : text;
  charged_service_fee : nat;
  recipient : blob;
  domain_version : text;
  authorization_epoch : nat64;
  max_service_fee : nat;
  deadline : nat64;
  signature_dispatch_attempt : nat32;
  chain_id : nat64;
  finalized_block_hash : blob;
  finalized_block_timestamp : nat64;
  verifying_contract : blob;
  digest : blob;
  gross_amount : nat;
};
type NonterminalDepositRef = record {
  deposit_id : blob;
  owner_sequence : nat64;
};
type NonterminalDepositRefPage = record {
  next_cursor : opt nat64;
  deposits : vec NonterminalDepositRef;
};
type NotifyWithdrawalArgs = record { transaction_hash : blob };
type NotifyWithdrawalError = variant {
  LedgerFeeExceedsServiceFee : record {
    charged_service_fee : nat;
    ledger_fee : nat;
  };
  Busy;
  RpcUnavailable;
  TransactionNotConfirmed;
  InsufficientCycles;
  WithdrawalConflict;
  RpcInconsistent;
  RateLimited;
  InvalidTransactionHash;
  TransactionReverted;
  WithdrawalBeforeAdmissionBoundary : record {
    observed_withdrawal_id : blob;
    minimum_withdrawal_id : blob;
  };
  StorageFailure;
  BaseStateMismatch;
  TransactionNotFound;
  BridgeSignerMismatch;
  AnonymousCaller;
  InvalidBaseResponse;
};
type NotifyWithdrawalReceipt = variant {
  Duplicate : record { withdrawal_id : blob };
  Ingested : record {
    withdrawal_id : blob;
    finalized_checkpoint_block_number : nat64;
  };
};
type OperationalConfig = record {
  settlement_rate_limit_global : nat16;
  settlement_rate_limit_per_principal : nat16;
  settlement_cycle_ceiling : nat;
  settlement_rate_limit_per_record : nat16;
  mint_authorization_ttl_seconds : nat64;
  governance_evm_fee : EvmFeePolicy;
  mint_authorization_epoch : nat64;
  notification_rate_limit_global : nat16;
  deposit_rate_limit_window_seconds : nat64;
  fee_recipient : FeeRecipientConfig;
  notification_rate_limit_window_seconds : nat64;
  settlement_rate_limit_window_seconds : nat64;
  notification_ingestion_rate_limit_global : nat16;
  deposit_rate_limit_per_principal : nat16;
  deposit_rate_limit_global : nat16;
  pause_principal : principal;
  governance_principal : principal;
  confirmation_relayer_principal : principal;
  settlement_retry_interval_seconds : nat64;
  governance_replacement : GovernanceReplacementPolicy;
  governance_operator : blob;
  cycles_floor : nat;
};
type OperationalConfigArgs = record {
  settlement_cycle_ceiling : nat;
  governance_evm_fee : EvmFeePolicy;
  cycles_floor : nat;
};
type OperationalConfigError = variant { Unauthorized };
type OperationalConfigSealReceipt = record {
  activation_attestation : ActivationAttestation;
  lifecycle : ProductionLifecycle;
};
type PrepareBaseGovernanceReplacementArgs = record {
  max_priority_fee_per_gas : nat;
  operation_id : nat64;
  max_fee_per_gas : nat;
  expected_transaction_hash : blob;
};
type ProductionLifecycle = variant {
  Bootstrap;
  Activated;
  OperationalConfigSealed;
};
type PublicConfigInitializationError = variant {
  ConflictingAddress;
  Busy;
  Unauthorized;
  StorageFailure;
  DerivationUnavailable;
};
type RequestDepositRefundError = variant {
  AutomaticProgressPending : record { next_run_at_ns : opt nat64 };
  NotClaimable;
  Busy;
  InvalidDepositId;
  NotFound;
  InsufficientCycles;
  DepositIdentityConflict;
  RpcInconsistent;
  RateLimited : record { retry_after_seconds : nat64 };
  StorageFailure;
  BaseStateMismatch;
  FinalityUnavailable;
  AnonymousCaller;
};
type ReserveStatus = record {
  cycles_balance : nat;
  cycles_surplus : nat;
  sufficient : bool;
  required_cycles : nat;
};
type Result = variant {
  Ok : BaseGovernanceConfirmation;
  Err : BaseGovernanceError;
};
type Result_1 = variant {
  Ok : SettlementActionResult;
  Err : SettlementActionError;
};
type Result_10 = variant {
  Ok : vec SignedBaseGovernanceTransaction;
  Err : BaseGovernanceError;
};
type Result_11 = variant {
  Ok : ProductionLifecycle;
  Err : BaseGovernanceError;
};
type Result_12 = variant {
  Ok : vec opt WithdrawalView;
  Err : GetWithdrawalsError;
};
type Result_13 = variant { Ok; Err : PublicConfigInitializationError };
type Result_14 = variant { Ok : DepositIdPage; Err : ListDepositIdsError };
type Result_15 = variant {
  Ok : NonterminalDepositRefPage;
  Err : ListDepositIdsError;
};
type Result_16 = variant {
  Ok : NotifyWithdrawalReceipt;
  Err : NotifyWithdrawalError;
};
type Result_17 = variant { Ok; Err : AdminError };
type Result_18 = variant {
  Ok : ChecksumRefreshStatus;
  Err : StorageMaintenanceError;
};
type Result_19 = variant { Ok : DepositReceipt; Err : DepositError };
type Result_2 = variant {
  Ok : FeePayoutActionResult;
  Err : SettlementActionError;
};
type Result_20 = variant { Ok : DepositView; Err : RequestDepositRefundError };
type Result_21 = variant { Ok : FeePayoutReceipt; Err : AdminError };
type Result_22 = variant {
  Ok : OperationalConfigSealReceipt;
  Err : BaseGovernanceError;
};
type Result_23 = variant { Ok : text; Err : StorageMaintenanceError };
type Result_3 = variant {
  Ok : StorageValidationStatus;
  Err : StorageMaintenanceError;
};
type Result_4 = variant {
  Ok : EmergencyPauseReceipt;
  Err : BaseGovernanceError;
};
type Result_5 = variant {
  Ok : SignedBaseGovernanceTransaction;
  Err : BaseGovernanceError;
};
type Result_6 = variant {
  Ok : ActivationAttestation;
  Err : BaseGovernanceError;
};
type Result_7 = variant { Ok : ActivationStatus; Err : BaseGovernanceError };
type Result_8 = variant { Ok : AuditEventPage; Err : AdminError };
type Result_9 = variant {
  Ok : OperationalConfig;
  Err : OperationalConfigError;
};
type RotatePausePrincipalArgs = record { pause_principal : principal };
type RuntimeBinding = record {
  expected_bridge_signer : blob;
  base_chain_id : nat64;
  bridge_contract : blob;
  evm_rpc_canister_id : principal;
  deployment_instance_id : blob;
  schema_version : nat16;
  minimum_withdrawal_id : blob;
  index_canister_id : principal;
  ledger_canister_id : principal;
  expected_bridge_runtime_sha256 : blob;
  operational_config_sha256 : blob;
  timelock_contract : blob;
  rpc_provider_urls_sha256 : blob;
};
type SettlementActionError = variant {
  AutomaticProgressPending : record { next_run_at_ns : opt nat64 };
  InvalidId;
  Busy;
  WrongState;
  NotFound;
  InsufficientCycles;
  Unauthorized;
  RateLimited : record { retry_after_seconds : nat64 };
  StorageFailure;
  AnonymousCaller;
};
type SettlementActionResult = variant {
  Stopped : record { state : SettlementState; reason : SettlementStopReason };
  Complete : record { state : SettlementState };
  ReconciliationProgress : record { state : SettlementState };
  Deferred : record { state : SettlementState; next_run_at_ns : nat64 };
};
type SettlementSchedulerHealth = variant { Healthy; Degraded; Faulted };
type SettlementSchedulerStatus = record {
  last_dispatcher_run_at_ns : nat64;
  scheduled : nat64;
  expired : nat64;
  next_wakeup_at_ns : opt nat64;
  stopped : nat64;
  leased : nat64;
  last_internal_error : opt text;
  health : SettlementSchedulerHealth;
};
type SettlementState = variant {
  Deposit : DepositPhase;
  Withdrawal : WithdrawalPhase;
};
type SettlementStopReason = variant {
  LedgerFeeExceedsServiceFee;
  LedgerRejected : text;
  RpcUnavailable;
  RpcInconsistent;
  LedgerAmbiguous;
  LedgerUnavailable;
  Unknown : text;
  AuthorizationExpired;
  BaseStateMismatch;
  BridgeSignerMismatch;
  SigningUnavailable;
  InvalidBaseResponse;
};
type SignedBaseGovernanceTransaction = record {
  transaction_hash : blob;
  raw_transaction : blob;
  max_priority_fee_per_gas : nat;
  kind : BaseGovernanceOperationKind;
  generation : nat8;
  signed_at_ns : nat64;
  operation_id : nat64;
  max_fee_per_gas : nat;
  sender : blob;
  calldata : blob;
  target : blob;
  chain_id : nat64;
  nonce : nat64;
  gas_limit : nat;
};
type SigningFailureClass = variant {
  CallFailed;
  Storage;
  InvalidSignature;
  CostUnavailable;
  InsufficientCycles;
  ResponseDecode;
  InvalidPublicKey;
  CallRejected;
  RecoveryMismatch;
};
type StatusCounts = record {
  retained_audit_events : nat64;
  reconciliation_holds : nat64;
  retained_deposit_index_entries : nat64;
  pending_ledger_operations : nat64;
  withdrawals : nat64;
  deposits : nat64;
  reserved_deposit_mint_operations : nat64;
  reserved_deposit_mint_amount : nat;
  pruned_audit_events : nat64;
};
type StorageMaintenanceError = variant {
  StateChanged;
  Unauthorized;
  InvalidArgument : record { message : text };
  StorageFailure;
  NotStarted;
};
type StorageValidationStatus = record {
  complete : bool;
  phase : text;
  scanned_rows : nat64;
};
type WithdrawalPhase = variant {
  Paid;
  ReleasePending;
  ReconciliationHold;
  Observed;
};
type WithdrawalView = record {
  charged_service_fee : nat;
  withdrawal_id : blob;
  max_service_fee : nat;
  release_ledger_block_index : opt nat;
  last_settlement_stop_reason : opt SettlementStopReason;
  amount_out : nat;
  state : WithdrawalPhase;
  ledger_fee : nat;
  amount : nat;
};
service : (BridgeInitArgs) -> {
  confirm_base_governance_transaction : (
      ConfirmBaseGovernanceTransactionArgs,
    ) -> (Result);
  continue_deposit : (blob) -> (Result_1);
  continue_fee_payout : (nat64) -> (Result_2);
  continue_storage_validation : (nat16) -> (Result_3);
  continue_withdrawal : (blob) -> (Result_1);
  emergency_pause : () -> (Result_4);
  execute_activation : () -> (Result_5);
  get_activation_attestation : () -> (Result_6) query;
  get_activation_status : () -> (Result_7) query;
  get_audit_events : (nat64, nat16) -> (Result_8) query;
  get_bridge_status : () -> (BridgeStatus) query;
  get_deposit : (blob) -> (opt DepositView) query;
  get_deposit_by_owner_sequence : (principal, nat64) -> (opt DepositView) query;
  get_next_deposit_sequence : (principal) -> (nat64) query;
  get_operational_config : () -> (Result_9) query;
  get_pending_base_governance_transaction : () -> (Result_10) query;
  get_production_lifecycle : () -> (Result_11) query;
  get_runtime_binding : () -> (RuntimeBinding) query;
  get_withdrawal : (blob) -> (opt WithdrawalView) query;
  get_withdrawals : (vec blob) -> (Result_12) query;
  icrc10_supported_standards : () -> (vec Icrc10SupportedStandard) query;
  icrc21_canister_call_consent_message : (Icrc21ConsentMessageRequest) -> (
      Icrc21ConsentMessageResponse,
    );
  initialize_public_config : () -> (Result_13);
  list_deposit_ids : (ListDepositIdsArgs) -> (Result_14) query;
  list_nonterminal_deposit_refs : (ListDepositIdsArgs) -> (Result_15) query;
  notify_withdrawal : (NotifyWithdrawalArgs) -> (Result_16);
  pause_new_deposits : () -> (Result_17);
  prepare_base_governance_action : (BaseGovernanceAction) -> (Result_5);
  prepare_base_governance_replacement : (
      PrepareBaseGovernanceReplacementArgs,
    ) -> (Result_5);
  prepare_next_emergency_base_action : () -> (Result_5);
  refresh_activation_attestation : () -> (Result_6);
  refresh_storage_checksum : (nat64) -> (Result_18);
  request_deposit : (DepositArgs) -> (Result_19);
  request_deposit_refund : (blob) -> (Result_20);
  request_fee_payout : (nat) -> (Result_21);
  rotate_fee_recipient : (FeeRecipientConfig) -> (Result_17);
  rotate_pause_principal : (RotatePausePrincipalArgs) -> (Result_17);
  schedule_activation : () -> (Result_5);
  seal_operational_config : (OperationalConfigArgs) -> (Result_22);
  start_storage_validation : () -> (Result_3);
  storage_integrity_check : () -> (Result_23) query;
}