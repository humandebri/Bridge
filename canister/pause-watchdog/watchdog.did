type WatchdogInitArgs = record {
  poll_interval_seconds : nat64;
  failure_threshold : nat8;
  bridge_canister : principal;
  stale_after_seconds : nat64;
};
type WatchdogStatus = record {
  pause_attempts : nat64;
  last_success_ns : nat64;
  last_pause_attempt_ns : nat64;
  consecutive_failures : nat8;
};
service : (WatchdogInitArgs) -> {
  get_watchdog_status : () -> (WatchdogStatus) query;
}
