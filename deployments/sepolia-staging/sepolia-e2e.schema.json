{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "state", "created_at", "updated_at", "binding", "stages", "complete"],
  "properties": {
    "schema_version": { "const": 8 },
    "kind": { "const": "kinic-bridge-sepolia-staging-e2e" },
    "state": {
      "enum": [
        "AWAITING_BOOTSTRAP_ATTESTATION",
        "AWAITING_PREFLIGHT",
        "AWAITING_CURRENT_SCHEMA_UPGRADE",
        "AWAITING_POST_UPGRADE_BINDING",
        "AWAITING_FRONTEND_PUBLISH",
        "AWAITING_SMOKE_E2E",
        "AWAITING_WALLET_E2E",
        "AWAITING_REFUND_REHEARSAL",
        "AWAITING_RPC_REHEARSAL",
        "AWAITING_LIVE_ACCEPTANCE",
        "SHORT_DELAY_LIVE"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "local_e2e_sha256",
        "bridge_wasm_sha256",
        "bridge_candid_sha256",
        "stable_schema_version",
        "record_wire_version",
        "bridge_runtime_template_sha256",
        "bsns_runtime_template_sha256",
        "frontend_profile_sha256",
        "bridge_canister_id",
        "ledger_canister_id",
        "index_canister_id",
        "chain_id",
        "bridge_address",
        "bsns_address",
        "timelock_address",
        "bridge_runtime_sha256",
        "bsns_runtime_sha256",
        "expected_bridge_signer",
        "rpc_provider_urls_sha256",
        "environment_mode",
        "activation_timelock_delay_seconds",
        "deployment_instance_id",
        "minimum_withdrawal_id"
      ],
      "properties": {
        "source_commit": { "$ref": "#/$defs/gitCommit" },
        "local_e2e_sha256": { "$ref": "#/$defs/sha256" },
        "bridge_wasm_sha256": { "$ref": "#/$defs/sha256" },
        "bridge_candid_sha256": { "$ref": "#/$defs/sha256" },
        "stable_schema_version": { "const": 35 },
        "record_wire_version": { "const": 30 },
        "bridge_runtime_template_sha256": { "$ref": "#/$defs/evmHash" },
        "bsns_runtime_template_sha256": { "$ref": "#/$defs/evmHash" },
        "frontend_profile_sha256": { "$ref": "#/$defs/sha256" },
        "bridge_canister_id": { "$ref": "#/$defs/principal" },
        "ledger_canister_id": { "$ref": "#/$defs/principal" },
        "index_canister_id": { "$ref": "#/$defs/principal" },
        "environment_mode": { "const": "short-delay-test-only" },
        "activation_timelock_delay_seconds": { "const": 300 },
        "stable_schema_version": { "const": 35 },
        "record_wire_version": { "const": 30 },
        "deployment_instance_id": { "$ref": "#/$defs/evmHash" },
        "minimum_withdrawal_id": { "$ref": "#/$defs/evmHash" },
        "chain_id": { "const": 84532 },
        "bridge_address": { "$ref": "#/$defs/evmAddress" },
        "bsns_address": { "$ref": "#/$defs/evmAddress" },
        "timelock_address": { "$ref": "#/$defs/evmAddress" },
        "bridge_runtime_sha256": { "$ref": "#/$defs/evmHash" },
        "bsns_runtime_sha256": { "$ref": "#/$defs/evmHash" },
        "expected_bridge_signer": { "$ref": "#/$defs/evmAddress" },
        "rpc_provider_urls_sha256": { "$ref": "#/$defs/evmHash" }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_attestation", "preflight", "current_schema_upgrade", "post_upgrade_binding",
        "frontend_publish", "smoke_e2e", "wallet_e2e", "refund_rehearsal", "rpc_rehearsal",
        "live_acceptance"
      ],
      "properties": {
        "bootstrap_attestation": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "bootstrap_attestation" } } } }] },
        "preflight": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "preflight" } } } }] },
        "current_schema_upgrade": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "current_schema_upgrade" } } } }] },
        "post_upgrade_binding": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "post_upgrade_binding" } } } }] },
        "frontend_publish": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "frontend_publish" } } } }] },
        "smoke_e2e": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "smoke_e2e" } } } }] },
        "wallet_e2e": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "wallet_e2e" } } } }] },
        "refund_rehearsal": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "refund_rehearsal" } } } }] },
        "rpc_rehearsal": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "rpc_rehearsal" } } } }] },
        "live_acceptance": { "allOf": [{ "$ref": "#/$defs/stage" }, { "if": { "type": "object" }, "then": { "properties": { "stage": { "const": "live_acceptance" } } } }] }
      }
    },
    "complete": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evmHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "evmAddress": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "principal": { "type": "string", "pattern": "^[a-z0-9-]{5,63}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "stage", "observed_at", "source_commit", "artifacts", "details"],
          "properties": {
            "schema_version": { "const": 8 },
            "stage": {
              "enum": [
                "bootstrap_attestation", "preflight", "current_schema_upgrade", "post_upgrade_binding",
                "frontend_publish", "smoke_e2e", "wallet_e2e", "refund_rehearsal", "rpc_rehearsal",
                "live_acceptance"
              ]
            },
            "observed_at": { "type": "string", "format": "date-time" },
            "source_commit": { "$ref": "#/$defs/gitCommit" },
            "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
            "details": { "type": "object" }
          },
          "allOf": [
            {
              "if": { "properties": { "stage": { "const": "bootstrap_attestation" } }, "required": ["stage"] },
              "then": {
                "properties": {
                  "artifacts": {
                    "allOf": [
                      {
                        "contains": { "type": "object", "properties": { "kind": { "const": "historical-reinstall-decision" } }, "required": ["kind"] },
                        "minContains": 1,
                        "maxContains": 1
                      },
                      {
                        "contains": { "type": "object", "properties": { "kind": { "const": "historical-fresh-stack" } }, "required": ["kind"] },
                        "minContains": 1,
                        "maxContains": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": { "properties": { "stage": { "const": "preflight" } }, "required": ["stage"] },
              "then": {
                "properties": {
                  "artifacts": {
                    "allOf": [
                      { "contains": { "type": "object", "properties": { "kind": { "const": "live-public-config" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "upgrade-instance-check" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "withdrawal-admission-boundary" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "live-bridge-status" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "live-activation-status" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "live-storage-integrity" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "live-ledger-balance" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "live-ledger-metadata" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
                    ]
                  }
                }
              }
            },
            {
              "if": { "properties": { "stage": { "const": "current_schema_upgrade" } }, "required": ["stage"] },
              "then": { "properties": { "artifacts": { "allOf": [
                { "contains": { "type": "object", "properties": { "kind": { "const": "current_schema_upgrade-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                { "contains": { "type": "object", "properties": { "kind": { "const": "current_schema_upgrade-raw-capture" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
              ] } } }
            },
            {
              "if": { "properties": { "stage": { "const": "post_upgrade_binding" } }, "required": ["stage"] },
              "then": { "properties": { "artifacts": { "allOf": [
                { "contains": { "type": "object", "properties": { "kind": { "const": "post_upgrade_binding-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                { "contains": { "type": "object", "properties": { "kind": { "const": "post_upgrade_binding-raw-capture" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
              ] } } }
            },
            {
              "if": { "properties": { "stage": { "const": "frontend_publish" } }, "required": ["stage"] },
              "then": { "properties": { "artifacts": { "allOf": [
                { "contains": { "type": "object", "properties": { "kind": { "const": "frontend_publish-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                { "contains": { "type": "object", "properties": { "kind": { "const": "frontend_publish-raw-capture" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
              ] } } }
            },
            {
              "if": { "properties": { "stage": { "const": "smoke_e2e" } }, "required": ["stage"] },
              "then": { "properties": { "artifacts": { "allOf": [
                { "contains": { "type": "object", "properties": { "kind": { "const": "smoke_e2e-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                { "contains": { "type": "object", "properties": { "kind": { "const": "smoke_e2e-raw-capture" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
              ] } } }
            },
            {
              "if": { "properties": { "stage": { "const": "wallet_e2e" } }, "required": ["stage"] },
              "then": { "properties": { "artifacts": { "allOf": [
                { "contains": { "type": "object", "properties": { "kind": { "const": "wallet_e2e-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                { "contains": { "type": "object", "properties": { "kind": { "const": "wallet_e2e-raw-capture" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
              ] } } }
            },
            {
              "if": { "properties": { "stage": { "const": "refund_rehearsal" } }, "required": ["stage"] },
              "then": { "properties": { "artifacts": { "allOf": [
                { "contains": { "type": "object", "properties": { "kind": { "const": "refund_rehearsal-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                { "contains": { "type": "object", "properties": { "kind": { "const": "refund_rehearsal-raw-capture" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
              ] } } }
            },
            {
              "if": { "properties": { "stage": { "const": "rpc_rehearsal" } }, "required": ["stage"] },
              "then": { "properties": { "artifacts": { "contains": { "type": "object", "properties": { "kind": { "const": "rpc-rehearsal-manifest" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 } } }
            },
            {
              "if": { "properties": { "stage": { "const": "live_acceptance" } }, "required": ["stage"] },
              "then": {
                "properties": {
                  "artifacts": {
                    "allOf": [
                      { "contains": { "type": "object", "properties": { "kind": { "const": "reactivation-schedule-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "reactivation-execute-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
                      { "contains": { "type": "object", "properties": { "kind": { "const": "staging-monitoring-receipt" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
