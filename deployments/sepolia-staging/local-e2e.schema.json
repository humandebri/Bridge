{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_mode", "activation_timelock_delay_seconds", "stable_schema_version", "record_wire_version", "deployment_instance_id", "created_at", "source_commit", "bridge_wasm_sha256", "bridge_runtime_template_sha256", "bsns_runtime_template_sha256", "candid_sha256", "bridge_abi_sha256", "bsns_abi_sha256", "ledger_release", "ledger_wasm_sha256", "index_wasm_sha256", "state_upgrade", "tests"],
  "properties": {
    "schema_version": { "const": 8 },
    "environment_mode": { "const": "short-delay-test-only" },
    "activation_timelock_delay_seconds": { "const": 300 },
    "stable_schema_version": { "const": 35 },
    "record_wire_version": { "const": 30 },
    "deployment_instance_id": { "$ref": "#/$defs/evmHash" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bridge_wasm_sha256": { "$ref": "#/$defs/sha256" },
    "bridge_runtime_template_sha256": { "$ref": "#/$defs/evmHash" },
    "bsns_runtime_template_sha256": { "$ref": "#/$defs/evmHash" },
    "candid_sha256": { "$ref": "#/$defs/sha256" },
    "bridge_abi_sha256": { "$ref": "#/$defs/sha256" },
    "bsns_abi_sha256": { "$ref": "#/$defs/sha256" },
    "ledger_release": { "const": "ledger-suite-icrc-2026-03-09" },
    "ledger_wasm_sha256": { "const": "354dd6ecfdc72b5409805b31dea22c9db11df6e14095a5a68924eb63535e6d8a" },
    "index_wasm_sha256": { "const": "dab6808d0dfc06e5e88336d0c3d3e45e5448c6e36c2a781f3e9e09bd450f528c" },
    "state_upgrade": { "$ref": "#/$defs/stateUpgrade" },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_local_ci", "real_frontend_e2e", "canister_activation", "timelock_delay_enforced", "state_upgrade"],
      "properties": {
        "full_local_ci": { "const": "passed" },
        "real_frontend_e2e": { "const": "passed" },
        "canister_activation": { "const": "passed" },
        "timelock_delay_enforced": { "const": "passed" },
        "state_upgrade": { "const": "passed" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evmHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "stateUpgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "before", "after"],
      "properties": {
        "verified": { "const": true },
        "before": { "$ref": "#/$defs/upgradeState" },
        "after": { "$ref": "#/$defs/upgradeState" }
      }
    },
    "upgradeState": {
      "type": "object",
      "required": ["owner_sequence", "status", "runtime_binding", "operational_config", "deposits", "withdrawals", "audit_events", "activation_status", "storage_integrity"],
      "properties": {
        "owner_sequence": { "type": "string", "pattern": "^[0-9]+$" },
        "status": {
          "type": "object",
          "required": ["schema_version", "counts", "settlement_scheduler"],
          "properties": {
            "schema_version": { "type": ["string", "integer"] },
            "counts": {
              "type": "object",
              "required": ["pending_ledger_operations", "reserved_deposit_mint_operations"]
            },
            "settlement_scheduler": { "type": "object" }
          }
        },
        "runtime_binding": {
          "type": "object",
          "required": ["deployment_instance_id", "minimum_withdrawal_id", "base_chain_id", "bridge_contract", "expected_bridge_runtime_sha256", "timelock_contract", "expected_bridge_signer", "ledger_canister_id", "index_canister_id", "evm_rpc_canister_id", "rpc_provider_urls_sha256", "schema_version", "operational_config_sha256"]
        },
        "operational_config": {
          "type": "object",
          "required": ["deposit_rate_limit_window_seconds", "deposit_rate_limit_global", "deposit_rate_limit_per_principal", "notification_rate_limit_window_seconds", "notification_rate_limit_global", "notification_ingestion_rate_limit_global", "settlement_rate_limit_window_seconds", "settlement_rate_limit_global", "settlement_rate_limit_per_principal", "settlement_rate_limit_per_record", "settlement_retry_interval_seconds"]
        },
        "deposits": { "type": "array", "minItems": 1 },
        "withdrawals": { "type": "array" },
        "audit_events": { "type": "object" },
        "activation_status": {
          "type": "object",
          "required": ["pending_timelock_operation", "deposits_paused"]
        },
        "storage_integrity": { "const": "ok" }
      }
    }
  }
}
